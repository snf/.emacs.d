;;; whisper-input-tests.el --- Microphone warning tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'whisper)
(require 'whisper-input)

(ert-deftest whisper-input-warning-clears-only-its-own-message ()
  (let (my/whisper--input-warning echo)
    (cl-letf (((symbol-function 'active-minibuffer-window) (lambda () nil))
              ((symbol-function 'current-message) (lambda () echo))
              ((symbol-function 'message)
               (lambda (format-string &rest args)
                 (setq echo (and format-string (apply #'format format-string args))))))
      (my/whisper--set-input-warning "Microphone muted")
      (should (equal echo "Microphone muted"))
      (my/whisper--set-input-warning nil)
      (should-not echo)
      (my/whisper--set-input-warning "Microphone disconnected")
      (setq echo "An unrelated notification")
      (my/whisper--set-input-warning nil)
      (should (equal echo "An unrelated notification")))))

(ert-deftest whisper-input-warning-does-not-interrupt-the-minibuffer ()
  (let (my/whisper--input-warning displayed)
    (cl-letf (((symbol-function 'active-minibuffer-window) (lambda () t))
              ((symbol-function 'message) (lambda (&rest _) (setq displayed t))))
      (my/whisper--set-input-warning "Microphone muted")
      (should (equal my/whisper--input-warning "Microphone muted"))
      (should-not displayed))))

(ert-deftest whisper-input-filter-handles-partial-lines-and-stale-processes ()
  (let* ((buffer (generate-new-buffer " *whisper input test*"))
         (process (make-pipe-process :name "whisper-input-test" :buffer buffer :noquery t))
         (my/whisper--input-monitor-process process)
         warnings)
    (unwind-protect
        (cl-letf (((symbol-function 'my/whisper--set-input-warning)
                   (lambda (warning) (push warning warnings))))
          (my/whisper--input-status-filter process "Installed dependency\n{\"warning\":\"Microphone ")
          (should-not warnings)
          (my/whisper--input-status-filter process "muted\"}\n{\"warning\":null}\n")
          (should (equal (reverse warnings) '("Microphone muted" nil)))
          (setq my/whisper--input-monitor-process nil)
          (my/whisper--input-status-filter process "{\"warning\":\"stale\"}\n")
          (should (= (length warnings) 2)))
      (delete-process process)
      (kill-buffer buffer))))

(ert-deftest whisper-input-file-conversion-does-not-check-the-microphone ()
  (let ((whisper--ffmpeg-input-format "pulse")
        (whisper--ffmpeg-input-file "/tmp/audio.wav")
        (my/whisper--input-monitor-process nil))
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest _) (ert-fail "File transcription started a microphone check"))))
      (my/whisper--start-input-monitor)
      (should-not my/whisper--input-monitor-process))))

(ert-deftest whisper-input-stop-cleans-up-the-monitor-and-warning ()
  (let* ((process (make-pipe-process :name "whisper-input-stop-test" :noquery t))
         (my/whisper--input-monitor-process process)
         (my/whisper--input-warning "Microphone muted"))
    (my/whisper--stop-input-monitor)
    (should-not (process-live-p process))
    (should-not my/whisper--input-monitor-process)
    (should-not my/whisper--input-warning)))

(ert-deftest whisper-input-remembers-only-healthy-microphones-across-restarts ()
  (let* ((directory (make-temp-file "whisper-input-state-" t))
         (my/whisper--input-state-file (expand-file-name "input.json" directory))
         (my/whisper--last-input-source nil))
    (unwind-protect
        (progn
          (my/whisper--remember-input '(:source "usb-microphone" :warning nil))
          (my/whisper--remember-input '(:source "fallback" :warning "Microphone disconnected"))
          (should (equal my/whisper--last-input-source "usb-microphone"))
          (setq my/whisper--last-input-source nil)
          (should (equal (my/whisper--expected-input) "usb-microphone")))
      (delete-directory directory t))))

(ert-deftest whisper-input-preflight-stops-a-bad-input-before-capture ()
  (let ((whisper--ffmpeg-input-format "pulse")
        (whisper--ffmpeg-input-device "default")
        (my/whisper--last-input-source "usb-microphone")
        (my/whisper--input-warning nil))
    (cl-letf (((symbol-function 'executable-find) (lambda (_) "/bin/sh"))
              ((symbol-function 'my/whisper--input-status-command)
               (lambda (once)
                 (should once)
                 '("sh" "-c" "printf '%s\\n' '{\"warning\":\"Microphone disconnected\",\"source\":\"fallback\"}'"))))
      (should-error (my/whisper--check-input) :type 'user-error)
      (should (equal my/whisper--input-warning "Microphone disconnected"))
      (should (equal my/whisper--last-input-source "usb-microphone")))))

(ert-deftest whisper-input-preflight-accepts-and-remembers-a-healthy-input ()
  (let* ((directory (make-temp-file "whisper-input-check-" t))
         (my/whisper--input-state-file (expand-file-name "input.json" directory))
         (my/whisper--last-input-source nil)
         (my/whisper--input-warning nil)
         (whisper--ffmpeg-input-format "pulse")
         (whisper--ffmpeg-input-device "default"))
    (unwind-protect
        (cl-letf (((symbol-function 'executable-find) (lambda (_) "/bin/sh"))
                  ((symbol-function 'my/whisper--input-status-command)
                   (lambda (_once)
                     '("sh" "-c" "printf '%s\\n' '{\"warning\":null,\"source\":\"usb-microphone\"}'"))))
          (my/whisper--check-input)
          (should-not my/whisper--input-warning)
          (should (equal (my/whisper--expected-input) "usb-microphone")))
      (delete-directory directory t))))

;;; whisper-input-tests.el ends here
