;;; whisper-realtime-tests.el --- Background dictation tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'whisper-target)
(require 'codex-voice)

(ert-deftest whisper-realtime-whole-recording-is-the-default ()
  (should-not (default-value 'my/whisper--realtime)))

(ert-deftest whisper-realtime-commands-select-their-own-processing-without-changing-defaults ()
  (let ((my/whisper--realtime t)
        (whisper--recording-process nil)
        (whisper--transcribing-process nil)
        (my/whisper--target-buffer nil)
        selections)
    (with-temp-buffer
      (cl-letf (((symbol-function 'my/whisper--check-input) #'ignore)
                ((symbol-function 'whisper-run)
                 (lambda () (push my/whisper--realtime selections))))
        (my/whisper-transcribe)
        (my/whisper-transcribe-realtime)
        (my/whisper-translate)
        (should (equal (nreverse selections) '(nil t nil)))
        (should my/whisper--realtime)))))

(ert-deftest whisper-realtime-disabled-uses-the-original-recorder ()
  (let ((my/whisper--realtime nil)
        called)
    (cl-letf (((symbol-function 'whisper--using-whispercpp-p)
               (lambda () (ert-fail "Disabled mode inspected the streaming backend"))))
      (should (eq (my/whisper-realtime--record-audio
                   (lambda () (setq called t) 'original-recorder))
                  'original-recorder)))
    (should called)))

(ert-deftest whisper-realtime-codex-commands-keep-mode-and-review-selection-independent ()
  (let ((my/whisper--realtime nil)
        (whisper--recording-process nil)
        (whisper--transcribing-process nil)
        (codex-voice--capture nil)
        (codex-voice-submit-by-default t)
        selections)
    (with-temp-buffer
      (setq-local whisper-insert-text-at-point t)
      (setq-local whisper-translate t)
      (cl-letf (((symbol-function 'codex-voice--prepare-target) #'ignore)
                ((symbol-function 'my/whisper--check-input) #'ignore)
                ((symbol-function 'codex-voice--read-context) (lambda (_) '(:context t)))
                ((symbol-function 'codex-voice--run-whisper-for-capture)
                 (lambda (capture)
                   (should (eq (plist-get capture :target) (current-buffer)))
                   (should (equal (plist-get capture :context) '(:context t)))
                   (push (list my/whisper--realtime (plist-get capture :submit)) selections)
                   (codex-voice--clear-capture capture))))
        (codex-voice-dictate-followup)
        (codex-voice-dictate-followup-realtime '(4))
        (codex-voice-dictate-followup)
        (should (equal (nreverse selections) '((nil t) (t nil) (nil t))))
        (should-not my/whisper--realtime)
        (should whisper-insert-text-at-point)
        (should whisper-translate)))))

(defmacro whisper-realtime-test--with-job (&rest body)
  "Run BODY with an isolated, controllable background dictation job."
  (declare (indent 0))
  `(let* ((target (generate-new-buffer " *dictation target*"))
          (output (generate-new-buffer " *dictation output*"))
          (logs (generate-new-buffer " *dictation logs*"))
          (audio (make-temp-file "dictation-test-" nil ".wav"))
          (process (make-process :name "dictation-test" :command '("cat")
                                 :buffer output :connection-type 'pipe :noquery t
                                 :filter #'ignore :sentinel #'ignore))
          (whisper--recording-process process)
          (whisper--transcribing-process nil)
          (my/whisper--target-buffer target)
          (codex-voice--capture nil)
          (codex-voice--transcription-processes nil)
          (whisper-after-transcription-hook nil)
          (whisper-after-insert-hook nil))
     (process-put process 'whisper-realtime t)
     (process-put process 'whisper-realtime-logs logs)
     (process-put process 'whisper-realtime-audio audio)
     (process-put process 'whisper-realtime-target target)
     (process-put process 'whisper-realtime-insert t)
     (process-put process 'whisper-realtime-marker
                  (with-current-buffer target (point-marker)))
     (process-put process 'whisper-realtime-draft
                  (with-current-buffer output (point-marker)))
     (unwind-protect
         (with-current-buffer target ,@body)
       (when (process-live-p process) (delete-process process))
       (dolist (buffer (list target output logs))
         (when (buffer-live-p buffer) (kill-buffer buffer)))
       (when (file-exists-p audio) (delete-file audio)))))

(defun whisper-realtime-test--finish (process &optional incomplete)
  "Complete fake PROCESS, optionally omitting its completion event."
  (unless incomplete
    (my/whisper-realtime--event process '(:event "stopped")))
  (process-send-eof process)
  (while (process-live-p process) (accept-process-output process 0.05))
  (my/whisper-realtime--finished process "finished\n"))

(ert-deftest whisper-realtime-keeps-all-text-hidden-until-completion ()
  (whisper-realtime-test--with-job
    (insert "Before:  After.")
    (set-marker (process-get process 'whisper-realtime-marker) 9)
    (let ((transcribed 0) (inserted 0))
      (let ((whisper-after-transcription-hook (list (lambda () (cl-incf transcribed))))
            (whisper-after-insert-hook (list (lambda () (cl-incf inserted)))))
        (my/whisper-realtime--event process '(:event "partial" :text "hola"))
        (my/whisper-realtime--event process '(:event "final" :text "Hola, mundo."))
        (my/whisper-realtime--event process '(:event "partial" :text "otra"))
        (my/whisper-realtime--event process '(:event "final" :text "Otra frase."))
        (should (equal (buffer-string) "Before:  After."))
        (should-not (get-buffer-window output t))
        (should (= transcribed 0))
        (should (= inserted 0))
        (with-current-buffer output
          (should (equal (buffer-string) "Hola, mundo.\nOtra frase.\n")))
        (whisper-realtime-test--finish process)
        (should (equal (buffer-string) "Before: Hola, mundo.\nOtra frase. After."))
        (should (= transcribed 1))
        (should (= inserted 1))
        (should-not (buffer-live-p output))
        (should-not (buffer-live-p logs))
        (should-not (file-exists-p audio))
        (should-not whisper--recording-process)
        (should-not whisper--transcribing-process)))))

(ert-deftest whisper-realtime-filter-handles-split-json-without-exposing-drafts ()
  (whisper-realtime-test--with-job
    (my/whisper-realtime--filter process "{\"event\":\"partial\",\"text\":\"¿Có")
    (with-current-buffer output (should (string-empty-p (buffer-string))))
    (my/whisper-realtime--filter process "mo estás?\"}\n")
    (should (string-empty-p (buffer-string)))
    (with-current-buffer output (should (equal (buffer-string) "¿Cómo estás?")))
    (my/whisper-realtime--filter process "{\"event\":\"final\",\"text\":\"¿Cómo estás?\"}\n")
    (whisper-realtime-test--finish process)
    (should (equal (buffer-string) "¿Cómo estás?"))))

(ert-deftest whisper-realtime-stops-from-another-buffer-and-follows-the-saved-marker ()
  (whisper-realtime-test--with-job
    (insert "before after")
    (set-marker (process-get process 'whisper-realtime-marker) 8)
    (goto-char (point-min))
    (insert "edited ")
    (my/whisper-realtime--event process '(:event "final" :text "dictated"))
    (let (signals)
      ;; The normal command can also stop an already-running real-time job.
      (cl-letf (((symbol-function 'signal-process)
                 (lambda (_process signal) (push signal signals))))
        (with-temp-buffer (my/whisper-transcribe) (my/whisper-transcribe)))
      (should (equal signals '(SIGINT))))
    (with-temp-buffer (whisper-realtime-test--finish process))
    (should (equal (buffer-string) "edited before dictatedafter"))))

(ert-deftest whisper-realtime-command-does-not-change-a-running-whole-recording-job ()
  (let* ((process (make-pipe-process :name "whole-recording-test" :noquery t))
         (whisper--recording-process process)
         (whisper--transcribing-process nil)
         interrupted)
    (unwind-protect
        (cl-letf (((symbol-function 'interrupt-process)
                   (lambda (job &rest _) (setq interrupted job)))
                  ((symbol-function 'signal-process)
                   (lambda (&rest _) (ert-fail "Whole recording used the stream protocol"))))
          (my/whisper-transcribe-realtime)
          (should (eq interrupted process))
          (should-not (my/whisper-realtime--p process)))
      (delete-process process))))

(ert-deftest whisper-realtime-cancel-discards-even-completed-hidden-blocks ()
  (whisper-realtime-test--with-job
    (insert "Existing text")
    (my/whisper-realtime--event process '(:event "final" :text "discard me"))
    (let (signal)
      (cl-letf (((symbol-function 'signal-process)
                 (lambda (_process value) (setq signal value))))
        (my/whisper-cancel-recording))
      (should (eq signal 'SIGTERM)))
    (whisper-realtime-test--finish process)
    (should (equal (buffer-string) "Existing text"))
    (should-not whisper--recording-process)
    (should-not whisper--transcribing-process)
    (should-not (file-exists-p audio))))

(ert-deftest whisper-realtime-silence-is-not-an-error-popup ()
  (whisper-realtime-test--with-job
    (cl-letf (((symbol-function 'display-buffer)
               (lambda (&rest _) (ert-fail "Silence opened an error buffer"))))
      (whisper-realtime-test--finish process))
    (should (string-empty-p (buffer-string)))
    (should (file-exists-p audio))
    (should-not (buffer-live-p logs))))

(ert-deftest whisper-realtime-cancelling-the-final-flush-discards-its-hidden-text ()
  (whisper-realtime-test--with-job
    (my/whisper-realtime--event process '(:event "final" :text "discard me"))
    (my/whisper-realtime--event process '(:event "capture-ended"))
    (should (eq whisper--transcribing-process process))
    (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
              ((symbol-function 'signal-process) #'ignore)
              ((symbol-function 'display-buffer)
               (lambda (&rest _) (ert-fail "Cancellation opened an error buffer"))))
      (my/whisper-transcribe)
      (whisper-realtime-test--finish process))
    (should (string-empty-p (buffer-string)))
    (should-not whisper--transcribing-process)))

(ert-deftest whisper-realtime-does-not-monitor-a-microphone-before-capture-starts ()
  (whisper-realtime-test--with-job
    (let (monitored)
      (cl-letf (((symbol-function 'my/whisper--start-long-recording-timer) #'ignore)
                ((symbol-function 'my/whisper--start-input-monitor)
                 (lambda () (setq monitored t))))
        (my/whisper--watch-recording-start)
        (should-not monitored)
        (my/whisper-realtime--event process '(:event "ready" :recording_pid 12345))
        (should monitored)))))

(ert-deftest whisper-realtime-an-incomplete-job-does-not-insert-its-draft ()
  (whisper-realtime-test--with-job
    (my/whisper-realtime--event process '(:event "partial" :text "incomplete"))
    (let (displayed)
      (cl-letf (((symbol-function 'display-buffer)
                 (lambda (buffer &rest _) (setq displayed buffer))))
        (whisper-realtime-test--finish process t))
      (should (eq displayed logs)))
    (should (string-empty-p (buffer-string)))
    (should (file-exists-p audio))))

(ert-deftest whisper-realtime-files-and-remote-services-use-the-existing-path ()
  (dolist (case '((file nil) (nil remote) (nil openai)))
    (let ((whisper--ffmpeg-input-file (car case))
          (my/whisper--realtime t)
          (whisper-server-mode (cadr case))
          called)
      (my/whisper-realtime--record-audio (lambda () (setq called t)))
      (should called))))

(ert-deftest whisper-realtime-command-starts-hidden-decoding-with-current-settings ()
  (let* ((model (make-temp-file "dictation-model-"))
         (vad (make-temp-file "dictation-vad-"))
         (whisper--recording-process nil)
         (whisper--transcribing-process nil)
         (whisper--compilation-buffer nil)
         (whisper-install-whispercpp nil)
         (whisper-server-mode nil)
         (whisper-before-transcription-hook nil)
         (whisper-recording-timeout nil)
         (whisper-language "es")
         (whisper-model "small")
         (my/whisper--target-buffer nil)
         process args)
    (unwind-protect
        (with-temp-buffer
          (emacs-lisp-mode)
          (insert "existing")
          (cl-letf (((symbol-function 'my/whisper--check-input) #'ignore)
                    ((symbol-function 'whisper--using-whispercpp-p) (lambda () t))
                    ((symbol-function 'whisper-command)
                     (lambda (_) (list "/bin/true" "--model" model "--vad-model" vad)))
                    ((symbol-function 'whisper--find-whispercpp-server) (lambda () "/bin/true"))
                    ((symbol-function 'make-process)
                     (lambda (&rest options)
                       (setq args (plist-get options :command)
                             process (make-pipe-process :name "dictation-start-test"
                                                        :buffer (plist-get options :buffer)
                                                        :noquery t :sentinel #'ignore)))))
            (my/whisper-transcribe-realtime)
            (should (my/whisper-realtime--p process))
            (should-not (eq (current-buffer) (process-buffer process)))
            (should (equal (buffer-string) "existing"))
            (should (eq major-mode 'emacs-lisp-mode))
            (should (equal (cadr (member "--language" args)) "es"))
            (should (equal (cadr (member "--model" args)) model))
            (should-not (member "--translate" args))
            (should (member "--save-audio" args))
            (should-not (member "--duration" args))))
      (when process
        (delete-process process)
        (dolist (buffer (list (process-buffer process)
                              (process-get process 'whisper-realtime-logs)))
          (when (buffer-live-p buffer) (kill-buffer buffer)))
        (delete-file (process-get process 'whisper-realtime-audio)))
      (delete-file model)
      (delete-file vad))))

(ert-deftest whisper-realtime-codex-shares-the-decoder-and-formats-only-once-at-the-end ()
  (whisper-realtime-test--with-job
    (let* ((context '(:last_assistant_message "A question"))
           (capture (codex-voice--install-capture target context t))
           calls)
      (set-process-sentinel process #'my/whisper-realtime--finished)
      (codex-voice--adopt-recording capture)
      (should (eq (process-sentinel process) #'my/whisper-realtime--finished))
      ;; Use manual completion below so the fixture controls callback timing.
      (set-process-sentinel process #'ignore)
      (cl-letf (((symbol-function 'codex-voice--start-formatter)
                 (lambda (&rest args) (push args calls)))
                ((symbol-function 'codex-voice--start-transcription)
                 (lambda (&rest _) (ert-fail "Audio was transcribed a second time"))))
        (my/whisper-realtime--event process '(:event "final" :text "Primera frase."))
        (my/whisper-realtime--event process '(:event "partial" :text "borrador"))
        (should-not calls)
        (should (eq codex-voice--capture capture))
        (my/whisper-realtime--event process '(:event "capture-ended"))
        (should-not whisper--recording-process)
        (should-not whisper--transcribing-process)
        (should-not codex-voice--capture)
        (should (memq process codex-voice--transcription-processes))
        (my/whisper-realtime--event process '(:event "final" :text "Segunda frase."))
        (whisper-realtime-test--finish process)
        (should (equal calls (list (list target context "Primera frase.\nSegunda frase." t))))
        (should-not codex-voice--transcription-processes)
        (should (string-empty-p (buffer-string)))))))

(ert-deftest whisper-realtime-codex-completion-does-not-touch-a-new-capture ()
  (whisper-realtime-test--with-job
    (let ((capture (codex-voice--install-capture target '(:old t) nil))
          (next (make-pipe-process :name "next-capture" :noquery t)))
      (unwind-protect
          (progn
            (codex-voice--adopt-recording capture)
            (my/whisper-realtime--event process '(:event "capture-ended"))
            (setq whisper--recording-process next)
            (let ((new-capture (codex-voice--install-capture target '(:new t) t)))
              (cl-letf (((symbol-function 'codex-voice--start-formatter) #'ignore)
                        ((symbol-function 'whisper--setup-mode-line)
                         (lambda (&rest _) (ert-fail "Old job changed the new capture indicator"))))
                (my/whisper-realtime--event process '(:event "final" :text "old text"))
                (whisper-realtime-test--finish process))
              (should (eq codex-voice--capture new-capture))
              (should (eq whisper--recording-process next))
              (codex-voice--clear-capture new-capture)))
        (delete-process next)))))

(ert-deftest whisper-realtime-codex-cancellation-never-formats-partial-text ()
  (whisper-realtime-test--with-job
    (let ((capture (codex-voice--install-capture target nil t)))
      (codex-voice--adopt-recording capture)
      (my/whisper-realtime--event process '(:event "final" :text "discard me"))
      (cl-letf (((symbol-function 'signal-process) #'ignore)
                ((symbol-function 'codex-voice--start-formatter)
                 (lambda (&rest _) (ert-fail "Cancelled dictation was formatted"))))
        (codex-voice-cancel-dictation)
        (whisper-realtime-test--finish process))
      (should-not codex-voice--capture)
      (should-not codex-voice--transcription-processes)
      (should (string-empty-p (buffer-string))))))

(ert-deftest whisper-realtime-codex-stop-signals-only-the-helper ()
  (whisper-realtime-test--with-job
    (let ((capture (codex-voice--install-capture target nil t))
          signalled)
      (codex-voice--adopt-recording capture)
      (cl-letf (((symbol-function 'signal-process)
                 (lambda (job signal) (setq signalled (list job signal))))
                ((symbol-function 'interrupt-process)
                 (lambda (&rest _) (ert-fail "Stop signalled the GPU backend"))))
        (codex-voice-dictate-followup))
      (should (equal signalled (list process 'SIGINT)))
      (codex-voice--clear-capture capture))))
